# Copy this file to backend/.env and replace the placeholders locally.
# Never commit backend/.env or paste a real key/password into source control.

# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=mysql+pymysql://YOUR_MYSQL_USER:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/ai_interview_evaluator

# Create a free key at https://console.groq.com/keys
# The placeholder below (and an empty value) is reported as "not configured".
GROQ_API_KEY=your_groq_api_key_here

# Currently supported Groq Whisper models:
# whisper-large-v3-turbo (default, faster/cheaper) or whisper-large-v3
GROQ_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SECONDS=60

# Groq accepts up to 25 MB per transcription request.
MAX_AUDIO_MB=25

# The Vite dev server origins that may call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Phase 2: automated answer evaluation
# ---------------------------------------------------------------------------

# Initial weights. They are normalized if they do not add up to 1.
EVALUATION_SEMANTIC_WEIGHT=0.70
EVALUATION_KEYWORD_WEIGHT=0.30

# Answers with fewer meaningful words are marked "unevaluable", not scored.
EVALUATION_MIN_MEANINGFUL_TOKENS=3

# Cached after the first evaluation. The first use downloads about 90 MB from
# Hugging Face and therefore needs internet access.
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_MODEL_DEVICE=cpu

# ---------------------------------------------------------------------------
# Phase 3: content statistics and voice measurements
# ---------------------------------------------------------------------------

# Where original recordings are stored. Relative paths resolve from backend/.
# Files are content-addressed and are ignored by git.
AUDIO_STORAGE_DIR=uploads

# Long recordings are analysed up to this many seconds; later audio is skipped
# and the response notes that only part of the file was measured.
VOICE_MAX_ANALYSIS_SECONDS=300

# Pitch tracking is CPU-heavy, so it runs on at most this much detected speech.
VOICE_PITCH_MAX_SECONDS=30

# Energy-VAD threshold passed to librosa.effects.split (dB below the peak).
VOICE_VAD_TOP_DB=35

# Silent gaps at least this long, between detected speech segments, count as
# pauses. Leading/trailing silence is reported as silence, not as a pause.
VOICE_MIN_PAUSE_SECONDS=0.3

# ---------------------------------------------------------------------------
# Phase 4: versioned score predictions (ML only when a validated artifact exists)
# ---------------------------------------------------------------------------

# No model artifact is included. A fresh checkout uses the labelled rule-based
# baseline. Train with: python -m services.ml_training --data labeled_scores.csv
# Relative paths resolve from backend/.
ML_MODEL_PATH=ml_artifacts/interview_score.joblib

# A model is marked "validated" only when the labelled dataset meets these
# minimums and beats the mean-prediction baseline on a group-aware holdout.
# --allow-small writes an explicitly unvalidated artifact that inference refuses.
ML_MIN_TRAINING_SAMPLES=60
ML_MIN_TRAINING_GROUPS=15
ML_TEST_FRACTION=0.25
ML_RANDOM_SEED=42
